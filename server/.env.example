# MongoDB connection string
# Local:   mongodb://localhost:27017/placement-tracker
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/placement-tracker
MONGO_URI=mongodb://localhost:27017/placement-tracker

# JWT signing secret — use a long, random string in production
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Port the server listens on (defaults to 5001 if not set)
PORT=5001

# Environment: development | production
NODE_ENV=development
